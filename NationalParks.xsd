<?xml version="1.0" encoding="utf-8"?>
<!--
  CSE 445 Assignment 4 - Q1.1
  NationalParks.xsd

  Schema for my national parks file, based on the tree in Figure 1:

    NationalParks
      NationalPark        <- Rating attribute (optional)
        Name
        Phone             <- can have more than one
        Address           <- NearestAirport attribute (required)
          Number, Street, City, State, Zip

  I set this up the same way as the Courses.xsd example from the assignment:
  a target namespace, a global element at the top, and named complexTypes
  underneath it. Everything uses xsd:sequence so the elements have to be in
  the same left to right order as the figure.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
   xmlns="https://dakshdesai42.github.io/cse445-assignment4"
   targetNamespace="https://dakshdesai42.github.io/cse445-assignment4"
   elementFormDefault="qualified" attributeFormDefault="unqualified">

   <xsd:annotation>
      <xsd:documentation xml:lang="en">
       CSE 445 Assignment 4 - directory of US national parks
      </xsd:documentation>
   </xsd:annotation>

   <!-- the root element -->
   <xsd:element name="NationalParks" type="NationalParksType"/>

   <!-- holds all of the parks, need at least one -->
   <xsd:complexType name="NationalParksType">
      <xsd:sequence>
         <xsd:element name="NationalPark" type="NationalParkDetails" minOccurs="1" maxOccurs="unbounded"/>
      </xsd:sequence>
   </xsd:complexType>

   <!-- one park. Phone is unbounded because parks can list several numbers.
        Rating is the optional attribute, so some parks have it and some don't -->
   <xsd:complexType name="NationalParkDetails">
      <xsd:sequence>
         <xsd:element name="Name" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="Phone" type="xsd:string" minOccurs="1" maxOccurs="unbounded"/>
         <xsd:element name="Address" type="AddressType" minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
      <xsd:attribute name="Rating" type="xsd:decimal" use="optional"/>
   </xsd:complexType>

   <!-- the address. NearestAirport is the required attribute, so every
        address has to have it -->
   <xsd:complexType name="AddressType">
      <xsd:sequence>
         <xsd:element name="Number" type="xsd:int" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="Street" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="City" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="State" type="xsd:string" minOccurs="1" maxOccurs="1"/>
         <xsd:element name="Zip" type="xsd:int" minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
      <xsd:attribute name="NearestAirport" type="xsd:string" use="required"/>
   </xsd:complexType>

</xsd:schema>
